# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#      cp .env.example .env
# 2. Fill in your real server IP, credentials, and SonarQube settings below.
# 3. DO NOT commit '.env' to git (.gitignore is configured to ignore it).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LINUX DEPLOYMENT SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# The IP address of your target Linux server with Docker installed
SERVER_IP=192.168.1.100

# The SSH Port on your Linux server (default: 22)
SERVER_PORT=22

# The SSH user to log in to the Linux server (e.g. root, ubuntu, deployer)
SERVER_USER=root

# The SSH password for the user above
SERVER_PASSWORD=your_linux_password_here

# The port exposed on the host to access the app (e.g. http://SERVER_IP:3000)
APP_PORT=3000

# ------------------------------------------------------------------------------
# 2. SONARQUBE SERVER CONFIGURATION (OPTIONAL)
# ------------------------------------------------------------------------------
# Toggle SonarQube code scanning (true / false)
ENABLE_SONAR_SCAN=true

# SonarQube Server URL (e.g. http://192.168.1.200:9000)
SONAR_HOST_URL=http://192.168.1.200:9000

# SonarQube User / Project Authentication Token
SONAR_TOKEN=your_sonarqube_token_here

# SonarQube Project Key
SONAR_PROJECT_KEY=simple-next-app
